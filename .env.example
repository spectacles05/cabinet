# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Never prefix with NEXT_PUBLIC_. Used only by the tests and scripts; the app itself never reads it. Don't add it to Vercel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Console → API Keys. Server-only.
ANTHROPIC_API_KEY=sk-ant-...

# Demo Mode vs Live AI. Unset or "demo": Demo Mode only, never calls the Anthropic API (safe default for
# any deployment, e.g. a Vercel preview). "live": always Live AI. "switchable": choose per browser in the
# account menu, starting in Demo Mode (recommended for local development).
CABINET_MODE=switchable

# In Live AI Mode, which engine reads policies: auto (Claude, falling back to the rule-based reader if Claude is
# unavailable, e.g. no credit), claude (Claude only), or rules (rule-based reader only, no AI calls).
AI_ENGINE=auto

# Optional: daily AI caps per rolling 24 hours (defaults shown). Over a cap, the free rule-based engine answers.
# AI_DAILY_CALLS_PER_USER=300
# AI_DAILY_CALLS_TOTAL=1500

# Optional: the address shown on the Contact us page. Until it's set, Contact us is hidden.
CONTACT_EMAIL=

# Upload limits
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=50

# Optional: lets `npm run db:apply -- <file.sql>` apply migrations without the SQL Editor.
# Supabase → Connect (top bar) → "Session pooler" URI, with your database password filled in. Server-only.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres
