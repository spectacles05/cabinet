  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "samples": "tsx scripts/make-sample-pdfs.ts",
    "db:apply": "tsx scripts/db-apply.ts",
    "eval:extraction": "tsx --conditions=react-server scripts/eval-extraction.ts",
