    "eval:claims": "tsx --conditions=react-server scripts/eval-claims.ts",
    "test:security": "cross-env REQUIRE_SUPABASE_TESTS=1 vitest run tests/rls.test.ts tests/deletion.test.ts tests/demo-workflows.test.ts",
    "test:e2e": "next build && playwright test",
    "evidence:logs": "tsx --conditions=react-server scripts/export-sample-logs.ts"
